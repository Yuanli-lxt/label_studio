# Compose project
COMPOSE_PROJECT_NAME=label-platform

# Service ports exposed on localhost
LABEL_STUDIO_PORT=18080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ML_BACKEND_PORT=9090
ML_BACKEND_GPU_PORT=9092
TRAINER_PORT=9091
# If Docker Desktop WSL port forwarding returns a 500 while publishing these ports,
# keep container ports unchanged and override only host ports temporarily:
# ML_BACKEND_GPU_PORT=19092
# TRAINER_PORT=19091

# Label Studio (OSS) host URL
LABEL_STUDIO_HOST=http://localhost:18080
LABEL_STUDIO_UID=1000
# Local files are mounted to /label-studio/files (demo images in /label-studio/files/images)
LABEL_STUDIO_LOCAL_FILES_SERVING_ENABLED=true
LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT=/label-studio/files
# Phase 4 helper scripts default dataset path inside trainer container
TEXT_CLASSIFIER_DEMO_DATASET_PATH=/demo-tasks/text_classification_labeled_export.json
IMAGE_CLASSIFIER_DEMO_DATASET_PATH=/demo-tasks/image_classification_labeled_export.json
# Optional text-classifier quality tuning knobs
TEXT_CLS_MIN_TOTAL_SAMPLES=8
TEXT_CLS_MIN_PER_CLASS_SAMPLES=3
TEXT_CLS_MAX_IMBALANCE_RATIO=3.0
TEXT_CLS_EVAL_SPLIT_RATIO=0.25
TEXT_CLS_MIN_EVAL_SAMPLES=2
TEXT_CLS_UNCERTAIN_THRESHOLD=0.60
TEXT_CLS_UNCERTAIN_MARGIN=0.10
# Optional image-classifier quality tuning knobs
IMAGE_CLS_MIN_TOTAL_SAMPLES=6
IMAGE_CLS_MIN_PER_CLASS_SAMPLES=2
IMAGE_CLS_MAX_IMBALANCE_RATIO=3.0
IMAGE_CLS_EVAL_SPLIT_RATIO=0.25
IMAGE_CLS_MIN_EVAL_SAMPLES=2
IMAGE_CLS_UNCERTAIN_THRESHOLD=0.60
IMAGE_CLS_EVAL_MANIFEST_PATH=/demo-tasks/image_classification_eval_manifest.json
IMAGE_TRAINING_CANDIDATES_PATH=/demo-tasks/image_classification_training_candidates.jsonl

# Label Studio API for webhook task fetch (trainer -> label-studio).
# Label Studio 1.23+ JWT API tokens are supported; do not commit a real token.
# Host-side helper scripts default LABEL_STUDIO_URL to http://localhost:18080 unless you override it.
LABEL_STUDIO_URL=http://label-studio:8080
LABEL_STUDIO_API_TOKEN=
LABEL_STUDIO_TIMEOUT_SECONDS=5.0

# Label Studio image human review bootstrap/import flow
LABEL_STUDIO_IMAGE_REVIEW_PROJECT_TITLE=Image Classification Human Review
LABEL_STUDIO_IMAGE_REVIEW_PROJECT_DESCRIPTION=Human review project for image classification model mistakes and low-confidence cases.
LABEL_STUDIO_ML_BACKEND_URL=http://ml-backend:9090
# For the optional MobileSAM GPU backend, set this before running the segmentation bootstrap script:
# LABEL_STUDIO_ML_BACKEND_URL=http://ml-backend-gpu:9090
LABEL_STUDIO_TRAINER_WEBHOOK_URL=http://host.docker.internal:9091/webhook/label-studio
IMAGE_REVIEW_TASKS_PATH=demo_data/tasks/image_classification_review_tasks.json
IMAGE_EVAL_MANIFEST_PATH=demo_data/tasks/image_classification_eval_manifest.json
IMAGE_LABEL_CONFIG_PATH=label_configs/image_classification.xml
# Optional local helper switches
LABEL_STUDIO_SKIP_ML_BACKEND_SETUP=0
LABEL_STUDIO_SKIP_WEBHOOK_SETUP=0

# PostgreSQL
POSTGRES_DB=labelstudio
POSTGRES_USER=labelstudio
POSTGRES_PASSWORD=labelstudio

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Optional Docker GPU MobileSAM image segmentation backend
# Verify Docker GPU access first:
# docker run --rm --gpus all pytorch/pytorch:2.8.0-cuda12.6-cudnn9-runtime nvidia-smi
# Required host checkpoint path, mounted into ml-backend-gpu as /app/models/mobilesam/mobile_sam.pt:
# models/mobilesam/mobile_sam.pt
# The ml-backend-gpu service sets these container values:
# MODEL_STATE_PATH=/app/demo_data/model_state/current_image_segmentation_model.json
# IMAGE_SEG_BACKEND=mobilesam
# IMAGE_SEG_MODEL_TYPE=vit_t
# IMAGE_SEG_CHECKPOINT=/app/models/mobilesam/mobile_sam.pt
# IMAGE_SEG_DEVICE=cuda
# Prompt priority: data/meta bbox, data/meta candidates, rectanglelabels, then center fallback.
# Prediction result meta records prompt and pixel prompt_box.
# Smoke test fallback when host 9092 is unavailable:
# python scripts/smoke_mobilesam_segmentation_docker.py --compose-dir infra --project-id 3 --host-ml-backend-url http://127.0.0.1:19092
